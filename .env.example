# ============================================================
# VAULT 147 — ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this to .env (or server/.env) and populate with your live credentials
# NEVER COMMIT REAL KEYS TO SOURCE CONTROL
# ============================================================

PORT=5000
NODE_ENV=production

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Resend Email Service Credentials (from https://resend.com/api-keys)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=VAULT 147 <onboarding@resend.dev>
MANAGER_EMAIL=owner@yourdomain.com
OWNER_EMAIL=owner@yourdomain.com

# Business Configurations
PLATFORM_FEE_INR=10
DEFAULT_HOLD_MINUTES=10
VENUE_TIMEZONE=Asia/Kolkata
