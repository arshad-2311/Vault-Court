PORT=5000
NODE_ENV=production

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email Service Credentials (from https://resend.com/api-keys)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=VAULT 147 <onboarding@resend.dev>
MANAGER_EMAIL=manager@vault147.in

# Business Configurations
PLATFORM_FEE_INR=10
DEFAULT_HOLD_MINUTES=10
VENUE_TIMEZONE=Asia/Kolkata
